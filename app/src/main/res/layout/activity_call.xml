<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Luồng video từ xa (full màn hình nền) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Luồng video của mình (góc trên phải, nhỏ) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localView"
        android:layout_width="110dp"
        android:layout_height="150dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:elevation="4dp" />

    <!-- Trạng thái cuộc gọi -->
    <TextView
        android:id="@+id/callStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="56dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:shadowColor="#AA000000"
        android:shadowRadius="4"
        android:text="Đang kết nối..." />

    <!-- Thanh nút điều khiển phía dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="28dp"
        android:background="#88000000">

        <!-- Tắt/bật Micro -->
        <Button
            android:id="@+id/btnToggleMic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="20dp"
            android:text="Mic"
            android:backgroundTint="#FF424242"
            android:textColor="#FFFFFFFF"
            style="?attr/materialButtonStyle" />

        <!-- Kết thúc cuộc gọi (giữa, đỏ) -->
        <Button
            android:id="@+id/btnEndCall"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="#FFE53935"
            android:text="Kết thúc"
            android:textColor="#FFFFFFFF"
            style="?attr/materialButtonStyle" />

        <!-- Tắt/bật Camera -->
        <Button
            android:id="@+id/btnToggleCam"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:backgroundTint="#FF424242"
            android:text="Cam"
            android:textColor="#FFFFFFFF"
            style="?attr/materialButtonStyle" />
    </LinearLayout>

</RelativeLayout>
